<?xml version="1.0" encoding="UTF-8"?>
<!-- Job: build every Java part in order: the shared library first, then the services.
     Run from the repo root: ./mvnw verify   One service: ./mvnw -pl services/chat-service -am verify -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.openbox</groupId>
  <artifactId>openbox-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>openbox-platform</name>

  <modules>
    <module>libs/platform-common-java</module>
    <module>services/chat-service</module>
    <module>services/ai-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- spring-boot:run only in services (they set it to false), so
         ./mvnw -pl services/<name> -am spring-boot:run works from the root. -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <!-- Windows: Tomcat's lowest-priority utility threads get starved and stall every
                 safepoint for seconds. Linux ignores thread priorities by default. -->
            <jvmArguments>-XX:-UseThreadPriorities</jvmArguments>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
