{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error-codes.schema.json",
  "title": "Error codes",
  "description": "Codes used in error responses { code, message? }, with the HTTP status each one maps to.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "status", "description"],
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
      },
      "status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
