{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error-body.schema.json",
  "title": "Error body",
  "description": "The body of every error response { code, message?, params? }. code comes from error-codes.json; params values are a string, a number or a list of strings.",
  "type": "object",
  "required": ["code"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
    },
    "message": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    }
  }
}
