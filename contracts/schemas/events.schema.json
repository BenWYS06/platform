{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.schema.json",
  "title": "Events",
  "description": "Events that services publish to each other. A breaking payload change gets a new version.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "version", "description"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
