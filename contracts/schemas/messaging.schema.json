{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "messaging.schema.json",
  "title": "Messaging names",
  "description": "RabbitMQ exchanges, queues and routing keys. Code uses name; the broker sees value.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "kind", "value", "description"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
      },
      "kind": {
        "enum": ["exchange", "queue", "routingKey"]
      },
      "value": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
