{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "messaging.schema.json",
  "title": "Messaging names",
  "description": "RabbitMQ exchanges, queues and routing keys, and Redis key patterns and hash fields. Code uses name; the broker or Redis sees value.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "kind", "value", "description"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
      },
      "kind": {
        "enum": ["exchange", "queue", "routingKey", "redisKey", "redisField"]
      },
      "value": {
        "type": "string"
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": { "properties": { "kind": { "enum": ["exchange", "queue", "routingKey"] } } },
        "then": { "properties": { "value": { "pattern": "^[a-z][a-z0-9]*(\.[a-z0-9]+)*$" } } }
      },
      {
        "if": { "properties": { "kind": { "const": "redisKey" } } },
        "then": {
          "properties": {
            "value": { "pattern": "^[a-z][a-z0-9]*(:([a-z][a-z0-9]*|\{[a-z][a-zA-Z0-9]*\}))+$" }
          }
        }
      },
      {
        "if": { "properties": { "kind": { "const": "redisField" } } },
        "then": { "properties": { "value": { "pattern": "^[a-z][a-zA-Z0-9]*$" } } }
      }
    ]
  }
}
