{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capabilities.schema.json",
  "title": "Capabilities",
  "description": "Permissions that roles grant, checked by every service.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "description"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
