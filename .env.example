# Job: list every environment variable the services need, with no real values.
# Copy to .env and fill in locally. Never commit .env.
# Variables are added here as each service is built (issues 0.3 to 0.7).

# Local infra (issue 0.3). Used by infra/docker-compose/compose.yml.
# RabbitMQ login for local development only; choose your own values in .env.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Host ports the services listen on; Caddy forwards /api/<service> to them.
AUTH_SERVICE_PORT=3001
CHAT_SERVICE_PORT=8081
AI_SERVICE_PORT=8082

# Services (issue 0.4). Read by auth-, chat- and ai-service; locally they also read this
# repo's .env at startup, so nothing below is required for local runs.
# Environment name: local, dev or prod. Missing means local.
APP_ENV=local
# Key for service-to-service /internal routes. Empty outside prod uses a local default;
# prod needs at least 32 random characters.
INTERNAL_API_KEY=
# Store addresses. Leave commented out locally to use these defaults; set them in prod.
# All services use the MongoDB database `platform`; the name is set in code, not here.
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# REDIS_URL=redis://localhost:6379
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672

# First owner and client IP (issue 1.1a, auth-service).
# Email of the first owner. While no user exists, auth prints an invite link for it at
# startup. Empty locally: no link, one warning. Required in prod (not this example value).
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# Origin of the web client, used in links. Default locally; required in prod.
# WEB_ORIGIN=http://localhost:5173
# Express trust proxy: hops to trust (1 = Caddy), true, false or addresses. Default 1 locally,
# none elsewhere. See docs/environments.md before setting it in prod.
# TRUST_PROXY=1
# Header that carries the client IP, for example cf-connecting-ip behind Cloudflare. Never set
# it on a host that clients can reach directly.
# CLIENT_IP_HEADER=
