{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBox auth service (Express + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.8.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
